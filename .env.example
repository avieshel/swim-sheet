# Vite loads mode-specific files from the repository root because client/vite.config.ts uses envDir: '..'.
# Local Docker values belong in .env.development.local. Hosted values belong in CI secrets or .env.production.local.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_AUTH_TEST_EMAIL=
VITE_AUTH_TEST_PASSWORD=
VITE_ENABLE_TEST_LOGIN=false
