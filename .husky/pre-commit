STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# Reject sensitive file TYPES before scanning content. trufflehog only
# pattern-matches known credential formats, so a pg_dump of the auth schema
# passes it cleanly (bcrypt hashes, 12-char token lookups). One was committed
# by accident before this check existed.
./utils/check-sensitive-files.sh --staged

if [ -n "$STAGED_FILES" ]; then
  RESULT=$(echo "$STAGED_FILES" | xargs trufflehog filesystem --no-verification --results=unverified 2>/dev/null)
  if [ -n "$RESULT" ]; then
    echo "$RESULT"
    echo "❌ Commit blocked: potential secrets detected."
    exit 1
  fi
  echo "✅ No secrets detected."
fi

(cd client && npx lint-staged)
cd client && npx tsc -b --noEmit
